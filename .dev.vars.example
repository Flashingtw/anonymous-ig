# Copy this file to .dev.vars for local Wrangler development.
# These are placeholders only. Never commit the real file or reuse production secrets.
APP_ENV="development"
ADMIN_AUTH_PROVIDER="github"

# Create a separate GitHub OAuth App for local development.
GITHUB_CLIENT_ID="replace-with-local-oauth-client-id"
GITHUB_CLIENT_SECRET="replace-with-local-oauth-client-secret"
GITHUB_REDIRECT_URI="http://127.0.0.1:8787/api/auth/github/callback"
FRONTEND_URL="http://127.0.0.1:8787/"
SESSION_SECRET="replace-with-at-least-32-random-characters"
SESSION_TTL_SECONDS="28800"

# Emergency local-only fallback. To use it, set provider=dev and mode=true.
# This is rejected whenever APP_ENV is not exactly development.
DEV_ADMIN_MODE="false"
DEV_ADMIN_TOKEN="replace-with-at-least-24-random-characters"

# Exact comma-separated frontend origins. Same-origin requests work without it.
ALLOWED_ORIGINS="http://127.0.0.1:8787,http://localhost:8787,http://localhost:8000"

# Phase-one anti-abuse adapters are disabled but already wired into POST.
RATE_LIMITING_ENABLED="false"
RATE_LIMIT_RETRY_AFTER_SECONDS="60"
CAPTCHA_ENABLED="false"
CAPTCHA_PROVIDER="turnstile"
CAPTCHA_SECRET="replace-only-when-captcha-is-enabled"
