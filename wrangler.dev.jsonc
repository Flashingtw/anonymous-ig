{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anonymous-submissions-api-local",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-08-31",
  "vars": { "IMAGE_STUDIO_ENABLED": "true", "SINGLE_SEND_ENABLED": "true", "SEND_CLEANUP_ENABLED": "false" },
  "r2_buckets": [{ "binding": "STUDIO_IMAGES", "bucket_name": "anonymous-studio-local" }],
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/[0-9][0-9][0-9][0-9]_*.sql"
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  }
}
