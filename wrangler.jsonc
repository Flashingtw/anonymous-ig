{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anonymous-submissions-api",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-08-31",
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "production": {
      "name": "anonymous-submissions-api-production",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./frontend",
        "binding": "ASSETS",
        "run_worker_first": true,
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "none"
      },
      "vars": {
        "APP_ENV": "production",
        "ADMIN_AUTH_PROVIDER": "github",
        "DEV_ADMIN_MODE": "false",
        "GITHUB_CLIENT_ID": "REPLACE_WITH_PRODUCTION_GITHUB_CLIENT_ID",
        "GITHUB_REDIRECT_URI": "https://replace-with-worker-subdomain.workers.dev/api/auth/github/callback",
        "FRONTEND_URL": "https://replace-with-worker-subdomain.workers.dev/",
        "PUBLIC_SITE_URL": "https://flashingtw.github.io/anonymous-ig/",
        "ALLOWED_ORIGINS": "https://flashingtw.github.io",
        "SESSION_TTL_SECONDS": "28800"
      },
      "secrets": {
        "required": [
          "GITHUB_CLIENT_SECRET",
          "SESSION_SECRET"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "anonymous-submissions-production",
          "database_id": "281ce1f3-dcdb-4d13-a749-709dee63043f",
          "migrations_dir": "migrations"
        }
      ]
      // The public submission page is on GitHub Pages. The sensitive admin UI
      // is served by this Worker so OAuth and session cookies stay same-origin.
    }
  }
}
